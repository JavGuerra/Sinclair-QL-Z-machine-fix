2910 REMark  PROCedure mensajes (linea)
2920 REMark  Sustituye cadenas del interprete por su traduccion. Lee los DATA que
2930 REMark  empiezan en la linea 'linea' (offset, original, longitud, traduccion;
2940 REMark  acaban con offset -1). Solo escribe en la posicion de cada cadena: no
2950 REMark  recorre el fichero. Pasada 1: comprueba longitudes y que el texto
2960 REMark  original esta en su sitio. Pasada 2 (solo si todo es correcto): escribe.
2970 REMark  Trabaja sobre el canal #3 (la copia abierta). No usa memoria extra.
2980 REMark  Suma en la variable global msgtot cada mensaje traducido (entradas de mas de 1 byte).
2990 REMark ==============================================================
3000 DEFine PROCedure mensajes (linea)
3010   LOCal pos, cnt, k, b%, o$, t$, bien
3020   bien = 1
3030   RESTORE linea
3040   REPeat validar
3050     READ pos, o$, cnt, t$
3060     IF pos = -1 THEN EXIT validar
3070     IF LEN(o$) <> cnt OR LEN(t$) <> cnt
3080       PRINT '  [!] Longitud en ';pos;': original ';LEN(o$);', nuevo ';LEN(t$);', debe ser ';cnt
3090       bien = 0
3100     ELSE 
3110       FOR k = 1 TO cnt
3120         BGET #3\(pos + k - 1), b%
3130         IF b% <> CODE(o$(k)) THEN bien = 0 : PRINT '  [!] El texto original no coincide en ';pos : EXIT k
3140       END FOR k
3150     END IF 
3160   END REPeat validar
3170   IF NOT bien
3180     PRINT '  Mensajes NO traducidos (l'&CHR$(147)&'nea ';linea;'): no se ha escrito nada.'
3190     msgerr = msgerr + 1
3200     RETurn 
3210   END IF 
3220   RESTORE linea
3230   REPeat escribir
3240     READ pos, o$, cnt, t$
3250     IF pos = -1 THEN EXIT escribir
3260     FOR k = 1 TO cnt
3270       BPUT #3\(pos + k - 1), CODE(t$(k))
3280     END FOR k
3290     IF cnt > 1 THEN msgtot = msgtot + 1 : REMark el parche de 1 byte (tecla S) no cuenta como mensaje
3300   END REPeat escribir
3310 END DEFine mensajes
