100 REMark ==========================================================
110 REMark  ZIPFIX_BAS - Caracteres espanoles para el interprete ZIP
120 REMark  Crea una COPIA de zip_exe y modifica la copia. No toca el
130 REMark  original. Requiere Toolkit II (TK2_EXT).
140 REMark ==========================================================
150 :
160 origen$ = 'flp1_zip_exe'
170 destino$ = 'flp1_zipes_exe'
180 errores = 0
190 msgerr = 0
200 msgtot = 0
210 enterr = 0
220 :
230 CLS : PRINT 'CONVERSI'&CHR$(150)&'N DE ZIP_EXE A ESPA'&CHR$(169)&'OL'
240 PRINT : PRINT 'Origen  [';origen$;']'
250 INPUT 'Origen (Enter = igual): ';a$ : IF a$ <> '' THEN origen$ = a$
260 PRINT 'Destino [';destino$;']'
270 INPUT 'Destino (Enter = igual): ';a$ : IF a$ <> '' THEN destino$ = a$
280 PRINT
290 IF origen$ == destino$ THEN PRINT 'Origen y destino no pueden ser iguales.' : STOP
300 :
310 REMark --- 1. Leer tipo y dataspace del original ---
320 OPEN_IN #3,origen$
330 tipo1 = FTYP(#3) : dat1 = FDAT(#3) : lon1 = FLEN(#3)
340 CLOSE #3
350 IF tipo1 <> 1 THEN PRINT 'AVISO: el origen no es un ejecutable (tipo ';tipo1;').' : PRINT 'Se ha perdido la cabecera? Descomprimelo con unzip bajo QL.' : STOP
360 :
370 REMark --- 2. Copiar CONSERVANDO la cabecera ---
380 PRINT 'Copiando zip_exe...'
390 COPY_O origen$ TO destino$
400 :
410 REMark --- 3. Comprobar que la copia es ejecutable ---
420 OPEN #3,destino$
430 tipo2 = FTYP(#3) : dat2 = FDAT(#3) : lon2 = FLEN(#3)
440 IF tipo2 <> tipo1 OR dat2 <> dat1 OR lon2 <> lon1
450   CLOSE #3
460   PRINT 'ERROR: la copia no conserva la cabecera del ejecutable.'
470   PRINT 'Origen: tipo ';tipo1;' dataspace ';dat1;' largo ';lon1
480   PRINT 'Copia : tipo ';tipo2;' dataspace ';dat2;' largo ';lon2
490   PRINT 'Prueba a copiar a mano con COPY_H y repite.'
500   STOP
510 END IF 
520 :
530 REMark --- 4. Comprobar que es la version esperada ---
540 PRINT 'Comprobando la versi'&CHR$(150)&'n de zip_exe...'
550 RESTORE 1560 : ok = 1 : bloque 0
560 IF NOT ok
570   CLOSE #3
580   PRINT 'ERROR: este zip_exe no es el esperado. No se modifica nada.'
590   PRINT '(Se ha dejado la copia sin tocar en ';destino$;')'
600   STOP
610 END IF 
620 :
630 REMark --- 5. Aplicar los parches ---
640 PRINT 'Aplicando los parches...'
650 RESTORE 1820 : bloque 1
660 :
670 REMark --- 6. Verificar lo escrito ---
680 PRINT 'Verificando. Espere, por favor...'
690 RESTORE 1820 : ok = 1 : bloque 2
700 REMark --- 7. Entrada de texto (opcional): el juego entiende lo que se teclea con
710 REMark     acentos y n (convierte los codigos del QL a los del juego). Para NO
720 REMark     aplicarlo, pon REMark al principio de la linea siguiente.
730 IF ok THEN entrada
740 REMark --- 8. Mensajes en castellano: todos en una unica tabla de DATA
750 REMark     (ver 'TABLA UNICA DE MENSAJES' al final). Para NO traducirlos,
760 REMark     pon REMark al principio de la linea siguiente.
770 IF ok THEN mensajes 3320 : REMark 3320 = primera linea de la tabla de mensajes
780 IF msgtot THEN PRINT '  Total de mensajes traducidos: ';msgtot
790 CLOSE #3
800 PRINT
810 IF ok
820   PRINT 'LISTO. Fichero modificado: ';destino$
830   PRINT 'No olvides usar el nuevo nombre del ejecutable para lanzar tus aventuras.'
840   PRINT 'Prueba: EW ';destino$;';"flp1_aventura_z5" (cambiar esto por el dispositivo y nombre de la aventura que corresponda).'
850   IF msgerr THEN PRINT 'AVISO: alg'&CHR$(153)&'n bloque de mensajes no se ha traducido (ver arriba).'
860   IF enterr THEN PRINT 'AVISO: el parche de entrada de texto no se ha aplicado (ver arriba).'
870 ELSE 
880   PRINT 'ERROR: la verificaci'&CHR$(150)&'n ha fallado. No uses ';destino$
890 END IF 
900 STOP
910 :
920 REMark Procesa un bloque de DATA: n, y n veces (posicion, cuantos, bytes)
930 REMark modo 0 = comprobar bytes esperados / modo 1 = escribir
940 REMark modo 2 = releer y comparar con lo escrito
950 DEFine PROCedure bloque (modo)
960   LOCal n, i, j, pos, cnt, v%, b%
970   READ n
980   FOR i = 1 TO n
990     READ pos, cnt
1000     FOR j = 0 TO cnt - 1
1010       READ v%
1020       IF modo = 1
1030         BPUT #3\(pos + j), v%
1040       ELSE 
1050         BGET #3\(pos + j), b%
1060         IF b% <> v% THEN ok = 0
1070       END IF 
1080     END FOR j
1090   END FOR i
1100 END DEFine bloque
1110 REMark ==============================================================
1120 REMark  PROCedure entrada
1130 REMark  Parche de la entrada de texto: convierte los acentos y la n tecleados
1140 REMark  (codigos del QL) a los codigos que usa el juego, para que el parser los
1150 REMark  reconozca. Comprueba el byte original de $1dce (BLOQUE 3), escribe el
1160 REMark  BLOQUE 4 y lo verifica. Si la comprobacion falla no escribe nada y deja
1170 REMark  enterr = 1. Si falla la verificacion final deja ok = 0.
1180 REMark ==============================================================
1190 DEFine PROCedure entrada
1200   LOCal oksave
1210   oksave = ok
1220   RESTORE 2540 : ok = 1 : bloque 0
1230   IF NOT ok
1240     PRINT '  Entrada de texto NO modificada: los bytes originales no coinciden.'
1250     enterr = 1
1260     ok = oksave
1270     RETurn
1280   END IF
1290   RESTORE 2600 : bloque 1
1300   RESTORE 2600 : ok = 1 : bloque 2
1310   IF ok
1320     PRINT '  Entrada de texto: caracteres convertidos.'
1330     ok = oksave
1340   ELSE
1350     PRINT '  ERROR: la verificaci'&CHR$(150)&'n del parche de entrada ha fallado.'
1360   END IF
1370 END DEFine entrada
